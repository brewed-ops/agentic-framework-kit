From: bench <bench@example.com>
Subject: [PATCH] fix: reference fix for since-filter

---
 src/store.mjs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/store.mjs b/src/store.mjs
index 24b4ca4..7d850b8 100644
--- a/src/store.mjs
+++ b/src/store.mjs
@@ -16,7 +16,7 @@ export function createStore() {
   // page is 1-based. since: only notes created after the note with that id.
   function list(owner, { page = 1, pageSize = 20, since } = {}) {
     let mine = [...notes.values()].filter((n) => n.owner === owner)
-    if (since !== undefined) mine = mine.filter((n) => Number(n.id) >= since)
+    if (since !== undefined) mine = mine.filter((n) => Number(n.id) > since)
     const start = (page - 1) * pageSize
     return { items: mine.slice(start, start + pageSize), total: mine.length, page, pageSize }
   }
